# Optional: use an LLM planner (any OpenAI-compatible endpoint: OpenAI, Ollama, vLLM, LM Studio).
# Leave AGENTGATE_LLM_MODEL empty to use the deterministic rule planner.
AGENTGATE_LLM_BASE_URL=http://localhost:11434/v1
AGENTGATE_LLM_API_KEY=
AGENTGATE_LLM_MODEL=

# Optional: require header X-API-Key on every API request except /health.
AGENTGATE_API_KEY=
